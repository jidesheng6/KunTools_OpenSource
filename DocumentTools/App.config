<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--配置初始页面索引，根据对照表，修改Value中的数字为对照表中的数字，重新打开软件即可-->
    <add key="StartPageIndex" value="0" />
    <!--配置是否开启高亮标签卡，修改Value为on表示开启，修改Value为off表示关闭，修改完毕后，重新打开软件即可-->
    <add key="TabPageHeighLight" value="off" />
    <!--设置是否开启标签卡的图标，默认为on，修改为off关闭，只在TabPageHeight值为off时生效-->
    <add key="ShowTabPageIco" value="on" />
    <!--配置是否开启转换完成后，显示打开转换目录弹窗的选项，修改Value为on表示开启，修改Value为off表示关闭，修改完毕后，重新打开软件即可-->
    <add key="ShowOpenTargetDialog" value="on" />
    <!--设置文件列表的行间距高度，修改value值即可，默认为35，值必须大于0，小于等于256-->
    <add key="ListViewLineHeight" value="25" />
    <!--设置是否开启文件列表网格线，修改value值即可，默认为on，为off关闭-->
    <add key="ListViewShowGridLines" value="on" />
    <!--配置隐藏不需要的页面，修改Value的值为索引值，多个页面使用逗号隔开，如：1,2,3 不填代表不隐藏-->
    <!--如若配置本项，建议从大到小进行配置，如：配置PPT转PDF、PDF转PPT不显示，则value内尽量填：5,4-->
    <add key="HidePageIndex" value="" />
    <!--配置html转pdf的浏览器驱动地址，若不配置，则每次都将自行选择路径-->
    <add key="ChromeDriverPath" value="" />
	<add key="Vfsoft_ExamDataPath" value="" />
	<add key="Vfsoft_MssDataPath" value="" />
    <!--界面的宽度-->
    <add key="FormWidth" value="" />
    <!--界面的高度-->
    <add key="FormHeight" value="" />
	<!--控件锚点是否开启，修改value值即可，默认为off，为on表示开启-->
    <add key="WidgetAnchorMode" value="off" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="false" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Drawing.Common" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Win32.Registry" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.0.0.0" newVersion="5.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
