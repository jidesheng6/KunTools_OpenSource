<ui:FluentWindow x:Class="DocumentTools.App.Shell.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tokens="clr-namespace:DocumentTools.App.Ui"
                 Title="DocumentTools"
                 Width="1440"
                 Height="900"
                 MinWidth="1180"
                 MinHeight="740"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar x:Name="TitleBar" Title="DocumentTools" Grid.Row="0" ShowMaximize="True" ShowMinimize="True">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="18" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="296" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Fluent left pane (explicit clicks — avoids nested NavigationViewItem selection bugs) -->
      <Border Grid.Column="0"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0"
              Padding="12,10,12,8">
        <DockPanel>
          <ui:TextBlock DockPanel.Dock="Top"
                        Text="功能导航"
                        FontTypography="BodyStrong"
                        Margin="6,2,6,8" />
          <ui:TextBox x:Name="SearchBox"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,8"
                      PlaceholderText="搜索功能  Ctrl+K"
                      TextChanged="SearchBox_OnTextChanged"
                      KeyDown="SearchBox_OnKeyDown"
                      Icon="{ui:SymbolIcon Search24}" />
          <TextBlock x:Name="NavVersion"
                     DockPanel.Dock="Bottom"
                     Margin="6,8,6,2"
                     FontSize="{x:Static tokens:UiTokens.CaptionFontSize}"
                     Foreground="{x:Static tokens:UiTokens.MutedBrush}" />
          <!-- 启动落点被回退时的说明（启动功能已隐藏 / 未注册），一次性提示 -->
          <TextBlock x:Name="NavStatus"
                     DockPanel.Dock="Bottom"
                     Visibility="Collapsed"
                     TextWrapping="Wrap"
                     Margin="6,6,6,0"
                     FontSize="{x:Static tokens:UiTokens.CaptionFontSize}"
                     Foreground="{x:Static tokens:UiTokens.MutedBrush}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,8,0">
            <StackPanel>
              <TextBlock x:Name="NavEmptyHint"
                         Visibility="Collapsed"
                         TextWrapping="Wrap"
                         Margin="6,12,6,0"
                         FontSize="{x:Static tokens:UiTokens.BodyFontSize}"
                         Foreground="{x:Static tokens:UiTokens.MutedBrush}" />
              <StackPanel x:Name="NavHost" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Background="{x:Static tokens:UiTokens.SurfaceBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 面包屑：只标出当前位置所属分类，标题层级交给页面自身 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,14,20,0">
          <ui:SymbolIcon x:Name="PageGlyph"
                         Symbol="Apps24"
                         FontSize="14"
                         Margin="0,1,7,0"
                         VerticalAlignment="Center"
                         Foreground="{x:Static tokens:UiTokens.MutedBrush}" />
          <TextBlock x:Name="PageCrumb"
                     VerticalAlignment="Center"
                     FontSize="{x:Static tokens:UiTokens.CaptionFontSize}"
                     Foreground="{x:Static tokens:UiTokens.MutedBrush}" />
        </StackPanel>
        <Border Grid.Row="1" Padding="16,4,16,16">
          <ContentControl x:Name="ContentHost" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
