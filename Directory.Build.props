    <RepositoryUrl>https://github.com/OWNER/DocumentTools</RepositoryUrl>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <!-- Chinese .cs sources: UTF-8 (BOM OK). See docs/feature-gap.md section 7 -->
  </PropertyGroup>
</Project>